# ─── Database ───────────────────────────────────────────────
# MongoDB Atlas connection string (or local mongodb://127.0.0.1:27017/fithub)
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/fithub?retryWrites=true&w=majority"

# ─── Auth (NextAuth.js) ─────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ─── Email (optional in dev — logs to console if unset) ─────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="FitHub <no-reply@fithub.app>"

# ─── Cloudinary (file storage) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Payments ───────────────────────────────────────────────
# SSLCommerz (Bangladesh)
SSLCZ_STORE_ID=""
SSLCZ_STORE_PASSWORD=""
SSLCZ_IS_LIVE="false"
# or Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
